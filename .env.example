# Nothing is required: log in at runtime with the edf_auth_login tool.

# ── Which home ───────────────────────────────────────────────────────────────
# Part of the address of the home to read, e.g. LYON. Needed only when the
# EDF account has several homes; when set, every read refuses any other home.
EDF_SITE=

# ── Login storage ────────────────────────────────────────────────────────────
# An EDF login lasts 20 minutes. When it runs out, the next tool call renews it
# silently through Safari (a background tab that closes itself) while Safari is
# signed in to EDF. Set to 0 to turn that off and log in again each time.
EDF_SILENT_RELOGIN=
# Where edf_auth_login stores the login. Defaults to ~/.config/edf/tokens.json.
EDF_TOKEN_FILE=

# ── Optional tuning ──────────────────────────────────────────────────────────
# Retry budget for 401 / 429 / 5xx responses. Defaults to 3.
EDF_MAX_RETRIES=3
# Per-request timeout in milliseconds. Defaults to 30000.
EDF_TIMEOUT_MS=
# Set to 1 to log each request to stderr.
EDF_DEBUG=
